<Window x:Class="TrailTeamRankings.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrailTeamRankings.App"
        mc:Ignorable="d"
        Title="Trail Team Rankings" Height="720" Width="1120">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:StringToVisibilityConverter x:Key="StrToVis" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Setup gate ===== -->
        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Registry:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,3" Margin="6,0,0,0"
                            Click="BrowseRegistry_Click" />
                    <TextBox Text="{Binding RegistryPath, Mode=OneWay}" IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,6"
                           Foreground="#1B7F3B" FontWeight="SemiBold"
                           Text="{Binding RegistryAthleteCount, StringFormat='✓ {0} athletes'}"
                           Visibility="{Binding RegistryLoaded, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Race URL:" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" VerticalContentAlignment="Center"
                         Text="{Binding RaceUrl, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Race date:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                            SelectedDate="{Binding RaceDate}" />
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Content="Live" IsChecked="{Binding LiveMode}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="18,4" FontWeight="Bold" />
                    <Button Content="Export Excel…" Click="ExportExcel_Click" IsEnabled="{Binding HasResults}"
                            Padding="14,4" Margin="8,0,0,0" />
                    <Button Content="Export PDF…" Click="ExportPdf_Click" IsEnabled="{Binding HasResults}"
                            Padding="14,4" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Error banner ===== -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,4" CornerRadius="4"
                Background="#FFF3F3" BorderBrush="#E0A0A0" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StrToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00000" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Tabs (disabled until the registry loads) ===== -->
        <TabControl Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding RegistryLoaded}">
            <TabItem Header="{Binding SenioriTeamsHeader}">
                <Grid>
                <DataGrid ItemsSource="{Binding SenioriTeams}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44" />
                        <DataGridTextColumn Header="Klub" Binding="{Binding Club}" Width="*" />
                        <DataGridTextColumn Header="muš 1" Binding="{Binding Male1}" Width="70" />
                        <DataGridTextColumn Header="muš 2" Binding="{Binding Male2}" Width="70" />
                        <DataGridTextColumn Header="žena 1" Binding="{Binding Female}" Width="70" />
                        <DataGridTextColumn Header="ukupno" Binding="{Binding Total}" Width="80" />
                        <DataGridCheckBoxColumn Header="Complete" Binding="{Binding Complete}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No Seniori teams for this race." Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SenioriTeamsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding JunioriTeamsHeader}">
                <Grid>
                <DataGrid ItemsSource="{Binding JunioriTeams}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44" />
                        <DataGridTextColumn Header="Klub" Binding="{Binding Club}" Width="*" />
                        <DataGridTextColumn Header="muš 1" Binding="{Binding Male1}" Width="70" />
                        <DataGridTextColumn Header="muš 2" Binding="{Binding Male2}" Width="70" />
                        <DataGridTextColumn Header="žena 1" Binding="{Binding Female}" Width="70" />
                        <DataGridTextColumn Header="ukupno" Binding="{Binding Total}" Width="80" />
                        <DataGridCheckBoxColumn Header="Complete" Binding="{Binding Complete}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No Juniori teams for this race." Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding JunioriTeamsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </TabItem>

            <TabItem Header="Individuals">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Division:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="130" ItemsSource="{Binding Divisions}"
                                  SelectedItem="{Binding IndividualsDivision}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock DockPanel.Dock="Top" Text="Men" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding MenIndividuals}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                                    <DataGridTextColumn Header="Ime i prezime" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Klub" Binding="{Binding Club}" Width="*" />
                                    <DataGridTextColumn Header="bodovi" Binding="{Binding Points}" Width="64" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Women" FontWeight="Bold" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding WomenIndividuals}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                                    <DataGridTextColumn Header="Ime i prezime" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Klub" Binding="{Binding Club}" Width="*" />
                                    <DataGridTextColumn Header="bodovi" Binding="{Binding Points}" Width="64" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="All runners">
                <DataGrid ItemsSource="{Binding AllRunners}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Place" Binding="{Binding Place}" Width="60" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="*" />
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="80" />
                        <DataGridTextColumn Header="Division" Binding="{Binding Division}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridCheckBoxColumn Header="Eligible" Binding="{Binding IsEligible}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{Binding ExcludedHeader}">
                <DataGrid ItemsSource="{Binding ExcludedRunners}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="130" />
                        <DataGridTextColumn Header="Division" Binding="{Binding Division}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- ===== Status bar ===== -->
        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastUpdated, StringFormat='Last updated: {0:HH:mm:ss}'}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Working…" Foreground="#1560B0" FontWeight="SemiBold"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
